# Server
NODE_ENV=development
PORT=5000

# Database
# Prisma requires a replica set. Local setup uses a dedicated instance on 27018
# (start it with ../scripts/start-mongo.ps1). If your MongoDB runs as a
# single-node replica set on 27017, use mongodb://localhost:27017/product_explorer
DATABASE_URL=mongodb://localhost:27018/product_explorer

# Auth
JWT_SECRET=super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# Seed
SEED_PRODUCTS=50000
