# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# Frontend origin allowed by CORS (comma separated for multiple)
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/email_queue_system

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# SMTP (Nodemailer) — fill with your own credentials
# If SMTP_HOST is left empty the app falls back
# to a JSON transport (dev mode) and logs the
# rendered message instead of sending it.
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
ADMIN_EMAIL=admin@example.com
SMTP_DISABLE_TLS=false
SMTP_FROM_NAME="Growfinix Booking Desk"